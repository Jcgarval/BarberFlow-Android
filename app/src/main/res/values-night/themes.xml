<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro -->
    <style name="Base.Theme.BarberFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bf_gold_light</item>
        <item name="colorOnPrimary">@color/bf_charcoal</item>
        <item name="colorPrimaryContainer">@color/bf_dark_gold_container</item>
        <item name="colorOnPrimaryContainer">@color/bf_gold_container</item>

        <item name="colorSecondary">@color/bf_gold_light</item>
        <item name="colorOnSecondary">@color/bf_charcoal</item>
        <item name="colorSecondaryContainer">@color/bf_dark_gold_container</item>
        <item name="colorOnSecondaryContainer">@color/bf_gold_container</item>

        <item name="android:colorBackground">@color/bf_dark_bg</item>
        <item name="colorOnBackground">@color/bf_dark_text</item>
        <item name="colorSurface">@color/bf_dark_surface</item>
        <item name="colorOnSurface">@color/bf_dark_text</item>
        <item name="colorSurfaceVariant">@color/bf_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/bf_dark_text_variant</item>
        <item name="colorOutline">@color/bf_dark_outline</item>

        <item name="colorError">@color/bf_dark_error</item>
        <item name="colorOnError">@color/bf_charcoal</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BarberFlow.Rounded</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BarberFlow.Rounded</item>
    </style>
</resources>
