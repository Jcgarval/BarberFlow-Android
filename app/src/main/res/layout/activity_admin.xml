<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="50dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel de Control"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>

        <!-- SECCIÓN BARBERO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir Nuevo Barbero"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_nombre_barbero"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Nombre del barbero"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_guardar_barbero"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Guardar Barbero"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <!-- SECCIÓN SERVICIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir Nuevo Servicio"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_nombre_servicio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Nombre (Ej. Corte Clásico)"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/et_duracion_servicio"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Minutos (Ej. 30)"
                android:inputType="number"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/et_precio_servicio"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Precio (Ej. 12.50)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_guardar_servicio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Guardar Servicio"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <!-- CERRAR SESIÓN -->
        <Button
            android:id="@+id/btn_cerrar_sesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cerrar Sesión"
            android:backgroundTint="#E57373"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>