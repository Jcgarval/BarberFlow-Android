<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:layout_marginBottom="8dp"
    android:background="#FFFFFF" android:elevation="2dp">

    <TextView
        android:id="@+id/tv_cita_fecha"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Fecha de la cita" android:textStyle="bold" android:textSize="16sp" android:textColor="#6750A4"/>

    <TextView
        android:id="@+id/tv_cita_detalles"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Detalles del cliente, barbero y servicio" android:layout_marginTop="4dp" android:textColor="#555555"/>
</LinearLayout>