<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título principal en azul oscuro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva Reserva"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta del Barbero con borde azul suave -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige a tu barbero:"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinner_barbero"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta del Servicio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Qué servicio quieres?"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinner_servicio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de la Fecha y Hora (Destacada en azul claro) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#BFDBFE"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Cuándo quieres venir?"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp"/>

                <!-- Selector de fecha con fondo azul cielo y texto azul oscuro -->
                <TextView
                    android:id="@+id/tv_FechaYHora"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Seleccionar Fecha y Hora"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="#1D4ED8"
                    android:background="#DBEAFE"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Principal (Azul vibrante) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reservar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Confirmar Reserva"
            android:textSize="18sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#2563EB"
            android:layout_marginBottom="12dp"/>

        <!-- Botón Secundario (Borde y texto azul) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_historial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ver mis citas"
            android:textSize="16sp"
            android:textColor="#2563EB"
            app:strokeColor="#2563EB"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Botón Peligro -->
        <Button
            android:id="@+id/btn_cerrar_sesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:textColor="#D32F2F"
            style="@style/Widget.AppCompat.Button.Borderless" />

    </LinearLayout>
</ScrollView>